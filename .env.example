# Resio has no required environment variables — the app runs fully client-side.
# The variables below only affect static builds for GitHub Pages.

# Base path of the deployed site. For a project site (repo "user/resio") set:
#   NEXT_PUBLIC_BASE_PATH=/resio
# For a user site (repo "user/user.github.io") leave it empty:
#   NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# Build mode switch: "1" produces a static export in .next-export/
# (used by .github/workflows/deploy.yml). Leave unset for normal builds.
STATIC_EXPORT=
